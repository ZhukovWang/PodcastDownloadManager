<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit v3 is a Microsoft.Testing.Platform test project: it builds to an executable that
         runs its own tests, so `dotnet test` no longer needs the VSTest host. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodcastDownloadManager\PodcastDownloadManager.csproj" />
  </ItemGroup>

</Project>
